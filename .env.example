# development | production  (auto-detected as production on Render/Vercel/Fly/Railway)
ENVIRONMENT=development
# Required in production: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PORT=8000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
# Extra comma-separated origins (localhost is allowed automatically in development)
CORS_ORIGINS=
# MongoDB is the only database. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=dsa_tracker
# Optional: Judge0 for running C++/Java against test cases (Python/JS run in the browser).
# RapidAPI:   JUDGE0_URL=https://judge0-ce.p.rapidapi.com  JUDGE0_API_HOST=judge0-ce.p.rapidapi.com  JUDGE0_API_KEY=<key>
# Self-host:  JUDGE0_URL=https://judge0.your-domain.com     JUDGE0_API_KEY=<X-Auth-Token>
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
